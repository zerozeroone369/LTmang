# Server Configuration
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Database (SQLite for local dev, switch provider to postgresql for production)
DATABASE_URL="file:./dev.db"

# JWT Security (Change in production! Use a strong 64+ char random string)
JWT_SECRET=change-this-to-a-secure-random-secret-in-env
JWT_EXPIRES_IN=1d

# Security Settings
BCRYPT_SALT_ROUNDS=10
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
